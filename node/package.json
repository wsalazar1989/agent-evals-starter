{
  "name": "agent-evals-starter-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small LangGraph agent with typed tools, guardrails and an eval harness (no API key needed for tests)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx src/evals/run.ts",
    "eval:scripted": "tsx src/evals/run.ts --scripted",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/openai": "^1.7.1",
    "langfuse": "^3.39.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
